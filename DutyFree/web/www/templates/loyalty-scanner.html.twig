{% include('header.html.twig') %}
<main>
	<h1>Loyalty card scanner</h1>
	<h4>Scan your loyalty card to check your loyalty program balance</h4>

	<form method="POST" enctype="multipart/form-data">
		<label>
			<svg
				xmlns="http://www.w3.org/2000/svg"
				fill="none"
				viewBox="0 0 24 24"
				stroke-width="1.5"
				stroke="currentColor">
				<path
					stroke-linecap="round"
					stroke-linejoin="round"
					d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5m-13.5-9L12 3m0 0 4.5 4.5M12 3v13.5" />
			</svg>

			<input type="file" name="loyalty_card" accept="image/png" />
			<div><strong>Choose an image</strong> or drag it here.</div></label
		>

		<img id="preview" src="" alt="" />

		<button id="scanNow" style="display: none">
			<svg
				xmlns="http://www.w3.org/2000/svg"
				fill="none"
				viewBox="0 0 24 24"
				stroke-width="1.5"
				stroke="currentColor">
				<path
					stroke-linecap="round"
					stroke-linejoin="round"
					d="M3.75 4.875c0-.621.504-1.125 1.125-1.125h4.5c.621 0 1.125.504 1.125 1.125v4.5c0 .621-.504 1.125-1.125 1.125h-4.5A1.125 1.125 0 0 1 3.75 9.375v-4.5ZM3.75 14.625c0-.621.504-1.125 1.125-1.125h4.5c.621 0 1.125.504 1.125 1.125v4.5c0 .621-.504 1.125-1.125 1.125h-4.5a1.125 1.125 0 0 1-1.125-1.125v-4.5ZM13.5 4.875c0-.621.504-1.125 1.125-1.125h4.5c.621 0 1.125.504 1.125 1.125v4.5c0 .621-.504 1.125-1.125 1.125h-4.5A1.125 1.125 0 0 1 13.5 9.375v-4.5Z" />
				<path
					stroke-linecap="round"
					stroke-linejoin="round"
					d="M6.75 6.75h.75v.75h-.75v-.75ZM6.75 16.5h.75v.75h-.75v-.75ZM16.5 6.75h.75v.75h-.75v-.75ZM13.5 13.5h.75v.75h-.75v-.75ZM13.5 19.5h.75v.75h-.75v-.75ZM19.5 13.5h.75v.75h-.75v-.75ZM19.5 19.5h.75v.75h-.75v-.75ZM16.5 16.5h.75v.75h-.75v-.75Z" />
			</svg>
			Scan now
		</button>
	</form>

	<!-- adapted from https://css-tricks.com/drag-and-drop-file-uploading/ -->
	<script>
		const form = document.forms[0];
		const label = form.querySelector('label:has(input[type="file"])');
		const input = form.querySelector('input[type="file"]');

		input.onchange = () => {
			if (input.files.length === 1 && input.files[0].type === 'image/png') {
				preview.src = URL.createObjectURL(input.files[0]);
				label.style.display = 'none';
				scanNow.style.display = 'flex';
			} else {
				preview.src = '';
			}
		};

		['drag', 'dragstart', 'dragend', 'dragover', 'dragenter', 'dragleave', 'drop'].forEach(function (event) {
			label.addEventListener(event, function (e) {
				// preventing the unwanted behaviours
				e.preventDefault();
				e.stopPropagation();
			});
		});
		['dragover', 'dragenter'].forEach(function (event) {
			label.addEventListener(event, function () {
				label.classList.add('is-dragover');
			});
		});

		['dragleave', 'dragend', 'drop'].forEach(function (event) {
			label.addEventListener(event, function () {
				label.classList.remove('is-dragover');
			});
		});

		label.addEventListener('drop', function (e) {
			input.files = e.dataTransfer.files;
			input.onchange();
		});
	</script>
</main>
{% include('footer.html.twig') %}
