{% include('header.html.twig') %}
<main>
	<form method="POST">
		<h3>Join the club</h3>
		<label>
			Full name
			<input name="full_name" type="text" value="{{ full_name }}" />
		</label>

		<label>
			Username
			<input name="username" type="text" value="{{ username }}" />
		</label>

		<label>
			Password
			<input name="password" type="password" value="{{ password }}" />
		</label>

		<div class="error">{{ error }}</div>

		<button>Register</button>

		<small
			>By registering you accept the <a href="/privacy-policy">privacy policy</a>, give us permission to sell your
			personal data on the black market, yada yada yada, the usual stuff</small
		>
	</form>
</main>
{% include('footer.html.twig') %}
