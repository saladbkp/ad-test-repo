{% include('header.html.twig') %}
<main>
	<h1>Order #{{ order.id }}</h1>

	<div class="order-info">
		<div><strong>Date:</strong> {{ order.created_at }}</div>
		<div><strong>Total price:</strong> {{ order.total|number_format(2, '.', ',') }}</div>
		<div><strong>Total loyalty points:</strong> {{ (order.total - order.loyalty_discount)|round(0, 'floor') }}</div>
	</div>

	<h3>Delegated users:</h3>
	<small>This is a list of users you can delegate to collect your order at the duty free desk at the airport.</small>

	<div class="delegation-list">
		{% for user in shared_users %}
		<div class="delegation-list-item">
			<form method="POST">
				<button>
					<svg
						xmlns="http://www.w3.org/2000/svg"
						fill="none"
						viewBox="0 0 24 24"
						stroke-width="1.5"
						stroke="currentColor">
						<path
							stroke-linecap="round"
							stroke-linejoin="round"
							d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" />
					</svg>
				</button>
				<input type="hidden" value="{{ user.username }}" name="delete" />
			</form>
			{{ user.username }}
		</div>
		{% if not loop.last %}
		<hr />
		{% endif %} {% else %}
		<div class="delegation-empty">you don't have any delegated users</div>
		{% endfor %}

		<hr />

		<form method="POST" class="delegate-new">
			<input type="text" placeholder="username" name="username" value="{{ username }}" />
			<button>
				<svg
					xmlns="http://www.w3.org/2000/svg"
					fill="none"
					viewBox="0 0 24 24"
					stroke-width="1.5"
					stroke="currentColor">
					<path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
				</svg>
				Delegate new user
			</button>
		</form>
		<div class="error">{{ error }}</div>
	</div>
</main>
{% include('footer.html.twig') %}
