{% include('header.html.twig') %}
<main>
	<div class="product-container">
		<div><img src="{{ product.image }}" alt="" /></div>
		<div>
			<form method="POST">
				<h1 class="product-name">{{ product.name }}</h1>

				<div class="product-price">&euro; {{ product.price|number_format(2, '.', ',') }}</div>

				<hr />

				{% if product.is_customizable %}
				<label class="product-customization">
					Customize product:
					<input name="customization" type="text" value="{{ customization }}" />
					<small>
						This text will be printed/etched on the product. For more information or special requests
						contact the seller.
					</small>
				</label>
				{% endif %}

				<div class="product-qty-cart">
					<label class="product-quantity">
						Quantity:
						<input
							name="quantity"
							type="number"
							value="{{ quantity != NULL ? quantity : 1 }}"
							min="1"
							max="100"
							step="1" />
					</label>

					<button>
						<svg
							xmlns="http://www.w3.org/2000/svg"
							fill="none"
							viewBox="0 0 24 24"
							stroke-width="1.5"
							stroke="currentColor">
							<path
								stroke-linecap="round"
								stroke-linejoin="round"
								d="M15.75 10.5V6a3.75 3.75 0 1 0-7.5 0v4.5m11.356-1.993 1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 0 1-1.12-1.243l1.264-12A1.125 1.125 0 0 1 5.513 7.5h12.974c.576 0 1.059.435 1.119 1.007ZM8.625 10.5a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm7.5 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z" />
						</svg>
						Add to cart
					</button>
				</div>

				{% if error %}
				<div class="error">{{ error }}</div>
				{% endif %}

				<hr />

				<div class="product-description">
					<div>Product information</div>
					{% for line in product.description|split('\n') %}
					<div>
						{{ line }}
					</div>
					{% endfor %}
				</div>
			</form>
		</div>
	</div>
</main>
{% include('footer.html.twig') %}
